# starts from image containing python. using slim to make it reproducible
FROM python:3.14-slim
# sets the working directory and environment variables for the application
WORKDIR /app
ENV PYTHONUNBUFFERED=1
# copies selected files into the image
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
# installs the dependencies 
RUN uv sync --locked --no-dev --no-install-project
COPY backend ./backend
ENV PATH="/app/.venv/bin:$PATH"
# defines how to start application when container runs
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]